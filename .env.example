# Copy this file to .env.local and paste your keys after the = signs (no quotes, no spaces).

# Claude (writes the comic script) — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (draws the panels) — get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: which OpenAI image model to use. Leave blank for the default (gpt-image-2.5-flare; set gpt-image-2 to go back).
OPENAI_IMAGE_MODEL=

# Optional: picture quality: low, medium (default) or high. Low is ~8x cheaper; good for testing.
OPENAI_IMAGE_QUALITY=
